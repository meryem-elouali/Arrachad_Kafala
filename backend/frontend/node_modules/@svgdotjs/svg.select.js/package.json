{
  "name": "@svgdotjs/svg.select.js",
  "version": "4.0.5",
  "description": "An extension of svg.js which allows to select elements with mouse",
  "type": "module",
  "main": "dist/svg.select.js",
  "module": "dist/svg.select.mjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/svg.select.d.mts",
        "default": "./dist/svg.select.mjs"
      },
      "import": {
        "types": "./dist/svg.select.d.mts",
        "default": "./dist/svg.select.mjs"
      },
      "require": {
        "types": "./dist/svg.select.d.ts",
        "default": "./dist/svg.select.js"
      }
    },
    "./src/svg.select.css": "./dist/svg.select.css",
    "./dist/svg.select.css": "./dist/svg.select.css",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/svg.select.js",
  "jsdelivr": "dist/svg.select.js",
  "files": [
    "/dist",
    "!/dist/*.zip"
  ],
  "keywords": [
    "svg.js",
    "select",
    "mouse"
  ],
  "bugs": "https://github.com/svgdotjs/svg.select.js/issues",
  "license": "MIT",
  "typings": "./dist/svg.select.d.ts",
  "author": "Ulrich-Matthias Schäfer",
  "homepage": "https://github.com/svgdotjs/svg.select.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svg.select.js.git"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.1.0"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test:package": "node test/browser-bundle.mjs",
    "demo": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "fix": "oxfmt --write . && oxlint -D correctness --fix .",
    "lint": "oxfmt --check . && oxlint -D correctness .",
    "zip": "zip -j dist/svg.select.js.zip -- LICENSE README.md dist/svg.select.js dist/svg.select.css"
  }
}